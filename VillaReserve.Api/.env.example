# VillaReserve — Environment Variables Example
#
# Copy this file to .env and fill in the values for your local development environment.
# NEVER commit .env to source control.
#
# The .env file is loaded automatically by Docker Compose.
# For dotnet run, set these as OS environment variables or use dotnet user-secrets.

# PostgreSQL container credentials (used by docker-compose.yml)
POSTGRES_DB=villareserve
POSTGRES_USER=villareserve_user
POSTGRES_PASSWORD=change_me_in_dev

# ASP.NET Core configuration (overrides appsettings.json when set as environment variable)
# Use double underscores (__) as the section separator for nested config.
Database__ConnectionString=Host=localhost;Port=5432;Database=villareserve;Username=villareserve_user;Password=change_me_in_dev
